<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analytics — SnipURL</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js">    document.querySelectorAll('.delete-form').forEach(form => {
        form.addEventListener('submit', (e) => {
            if (!confirm('Delete this link permanently?')) e.preventDefault();
        });
    });
</script>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --bg: #0f0f13; --surface: #18181f; --surface2: #1f1f2a;
            --border: #2a2a38; --accent: #6c63ff; --accent2: #22d3ee;
            --text: #e8e8f0; --text-muted: #8888aa;
            --success: #22c55e; --danger: #ef4444; --warn: #f59e0b; --radius: 12px;
        }
        body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }

        /* ── Nav ── */
        nav { display: flex; align-items: center; justify-content: space-between; padding: 0 2rem; height: 62px; background: var(--surface); border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 100; }
        .nav-brand { font-size: 1.2rem; font-weight: 700; }
        .nav-brand .dot { color: var(--accent); }
        .btn-home { padding: 0.45rem 1.1rem; border-radius: 8px; border: 1px solid var(--border); background: transparent; color: var(--text-muted); font-size: 0.85rem; font-family: 'Inter', sans-serif; cursor: pointer; text-decoration: none; transition: all 0.2s; }
        .btn-home:hover { border-color: var(--accent); color: var(--accent); }

        .container { max-width: 980px; margin: 0 auto; padding: 2.5rem 1.5rem 4rem; }

        /* ── Page header ── */
        .page-title { font-size: 1.5rem; font-weight: 700; margin-bottom: 0.3rem; }
        .page-sub { color: var(--text-muted); font-size: 0.88rem; margin-bottom: 2rem; }

        /* ── Info grid ── */
        .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; margin-bottom: 2rem; }
        .info-row { font-size: 0.82rem; color: var(--text-muted); background: var(--surface); border: 1px solid var(--border); border-radius: 9px; padding: 0.75rem 1rem; word-break: break-all; }
        .info-row strong { color: var(--text); font-weight: 500; display: block; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem; }
        .info-row a { color: var(--accent); text-decoration: none; }
        .info-row a:hover { text-decoration: underline; }
        .pill { display: inline-block; font-size: 0.72rem; padding: 0.2rem 0.55rem; border-radius: 999px; font-weight: 500; margin-top: 0.2rem; }
        .pill.expired { background: rgba(239,68,68,0.12); color: var(--danger); }
        .pill.active  { background: rgba(245,158,11,0.12); color: var(--warn); }
        .pill.forever { background: rgba(34,197,94,0.12);  color: var(--success); }
        .pill.paused  { background: rgba(136,136,170,0.12); color: var(--text-muted); }

        /* ── Stats row ── */
        .stats-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
        .stat-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.25rem 1.5rem; }
        .stat-label { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); margin-bottom: 0.4rem; }
        .stat-value { font-size: 2rem; font-weight: 700; color: var(--accent); }
        .stat-value.cyan { color: var(--accent2); }
        .stat-sub { font-size: 0.72rem; color: var(--text-muted); margin-top: 0.2rem; }

        /* ── Action buttons ── */
        .actions-row { display: flex; gap: 0.75rem; margin-bottom: 2rem; flex-wrap: wrap; }
        .btn-action { padding: 0.55rem 1.2rem; border-radius: 8px; border: 1px solid var(--border); background: transparent; color: var(--text-muted); font-size: 0.85rem; font-family: 'Inter', sans-serif; cursor: pointer; text-decoration: none; transition: all 0.2s; }
        .btn-action:hover { border-color: var(--accent); color: var(--accent); }
        .btn-action.danger:hover { border-color: var(--danger); color: var(--danger); }
        .btn-action.warn:hover   { border-color: var(--warn);   color: var(--warn); }

        /* ── Grid layout ── */
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-bottom: 1.25rem; }
        .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.25rem; margin-bottom: 1.25rem; }
        .col-span-2 { grid-column: span 2; }

        /* ── Chart cards ── */
        .chart-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.25rem 1.5rem; }
        .card-title { font-size: 0.78rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); margin-bottom: 1rem; }
        .chart-wrap { position: relative; }
        .chart-wrap.h160 { height: 160px; }
        .chart-wrap.h180 { height: 180px; }
        .chart-wrap.h140 { height: 140px; }

        /* ── Leaderboard lists ── */
        .leaderboard { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
        .lb-item { display: flex; align-items: center; gap: 0.6rem; font-size: 0.82rem; }
        .lb-bar-wrap { flex: 1; height: 6px; background: var(--surface2); border-radius: 999px; overflow: hidden; }
        .lb-bar { height: 100%; border-radius: 999px; background: var(--accent); }
        .lb-label { width: 90px; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .lb-count { width: 2rem; text-align: right; color: var(--text-muted); font-variant-numeric: tabular-nums; }
        .lb-flag { font-size: 1rem; }

        /* ── QR card ── */
        .qr-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.25rem; display: flex; flex-direction: column; align-items: center; gap: 0.75rem; }
        .qr-label { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); }
        .qr-card img { border-radius: 8px; display: block; }
        .btn-dl { padding: 0.45rem 1rem; border-radius: 7px; border: 1px solid var(--border); background: transparent; color: var(--text-muted); font-size: 0.78rem; text-decoration: none; transition: all 0.2s; text-align: center; width: 100%; }
        .btn-dl:hover { border-color: var(--accent); color: var(--accent); }

        /* ── Visit table ── */
        .table-wrap { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
        table { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
        thead tr { background: var(--surface2); border-bottom: 1px solid var(--border); }
        thead th { padding: 0.75rem 1rem; text-align: left; font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); }
        tbody tr { border-bottom: 1px solid var(--border); transition: background 0.15s; }
        tbody tr:last-child { border-bottom: none; }
        tbody tr:hover { background: var(--surface2); }
        tbody td { padding: 0.65rem 1rem; color: var(--text-muted); }
        .idx { width: 2.5rem; }
        .empty-state { text-align: center; padding: 3rem 2rem; color: var(--text-muted); font-size: 0.9rem; }

        /* ── Section divider ── */
        .section-heading { font-size: 0.88rem; font-weight: 600; color: var(--text); margin: 2rem 0 1rem; display: flex; align-items: center; gap: 0.5rem; }
        .section-heading::after { content: ''; flex: 1; height: 1px; background: var(--border); }

        @media (max-width: 700px) {
            .grid-2, .grid-3 { grid-template-columns: 1fr; }
            .col-span-2 { grid-column: span 1; }
            .info-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

<nav>
    <div class="nav-brand">✂ Snip<span class="dot">URL</span></div>
    <a href="/" class="btn-home">← Dashboard</a>
</nav>

<div class="container">
    <div class="page-title">Link Analytics</div>
    <div class="page-sub">Performance breakdown for <strong>/<%- shortId %></strong></div>

    <% if (locals.updated) { %>
    <div style="margin-bottom:1.25rem;padding:0.75rem 1rem;border-radius:9px;background:rgba(34,197,94,0.08);border:1px solid rgba(34,197,94,0.3);color:var(--success);font-size:0.85rem;">
        ✓ Destination URL updated and cache invalidated.
    </div>
    <% } %>

    <!-- Info Grid -->
    <div class="info-grid">
        <div class="info-row">
            <strong>Short URL</strong>
            <a href="<%= shortUrl %>" target="_blank"><%= shortUrl %></a>
        </div>
        <div class="info-row">
            <strong>Original URL</strong>
            <a href="<%= redirectId %>" target="_blank"><%= redirectId.length > 60 ? redirectId.slice(0,60) + '…' : redirectId %></a>
        </div>
        <div class="info-row">
            <strong>Created On</strong>
            <%= createdAt %>
        </div>
        <div class="info-row">
            <strong>Expiry</strong>
            <% if (expiresAt) { %>
                <%= expiresAt %>
                <% if (isExpired) { %><span class="pill expired">Expired</span><% } else { %><span class="pill active">Active</span><% } %>
            <% } else { %>
                Never <span class="pill forever">Permanent</span>
            <% } %>
        </div>
    </div>

    <!-- Stat cards -->
    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-label">Human Clicks</div>
            <div class="stat-value"><%= typeof humanClicks !== 'undefined' ? humanClicks : totalClicks %></div>
            <div class="stat-sub"><%= typeof botClicks !== 'undefined' ? botClicks : 0 %> bot clicks filtered</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Unique Visitors</div>
            <div class="stat-value cyan"><%= uniqueClicks %></div>
            <div class="stat-sub">by hashed IP</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Total Requests</div>
            <div class="stat-value" style="color:var(--text);"><%= totalClicks %></div>
            <div class="stat-sub">humans + bots</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Status</div>
            <div style="margin-top:0.6rem;">
                <% if (!isActive) { %>
                    <span class="pill paused" style="font-size:0.9rem;">⏸ Paused</span>
                <% } else if (isExpired) { %>
                    <span class="pill expired" style="font-size:0.9rem;">⏰ Expired</span>
                <% } else { %>
                    <span class="pill forever" style="font-size:0.9rem;">● Live</span>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Edit Destination URL -->
    <form method="POST" action="/url/edit/<%= shortId %>" style="display:flex;gap:0.6rem;margin-bottom:1.25rem;flex-wrap:wrap;">
        <input
            type="url"
            name="redirectId"
            value="<%= redirectId %>"
            required
            placeholder="https://new-destination.com"
            style="flex:1;min-width:220px;padding:0.55rem 0.9rem;border-radius:8px;border:1px solid var(--border);background:var(--surface);color:var(--text);font-size:0.85rem;outline:none;"
        >
        <button type="submit" class="btn-action">✎ Update Destination</button>
    </form>

    <!-- Actions -->
    <div class="actions-row">
        <form method="POST" action="/url/toggle/<%= shortId %>" style="display:inline">
            <button type="submit" class="btn-action warn">
                <%= isActive ? '⏸ Pause Link' : '▶ Resume Link' %>
            </button>
        </form>
        <form method="POST" action="/url/delete/<%= shortId %>" class="delete-form" style="display:inline">
            <button type="submit" class="btn-action danger">🗑 Delete Link</button>
        </form>
    </div>

    <!-- Row 1: 7-day chart + QR -->
    <div class="grid-2" style="margin-bottom:1.25rem;">
        <div class="chart-card col-span-2" style="grid-column: 1;">
            <div class="card-title">Clicks — Last 7 Days</div>
            <div class="chart-wrap h160"><canvas id="clickChart"></canvas></div>
        </div>
        <div class="qr-card">
            <div class="qr-label">QR Code</div>
            <img src="<%= qrDataUrl %>" alt="QR code" width="150" height="150">
            <a href="<%= qrDataUrl %>" download="snipurl-<%= shortId %>.png" class="btn-dl">⬇ Download PNG</a>
        </div>
    </div>

    <!-- Row 2: Device pie + Countries + Browsers -->
    <div class="section-heading">Audience Breakdown</div>

    <div class="grid-3">
        <!-- Device -->
        <div class="chart-card">
            <div class="card-title">Device Type</div>
            <div class="chart-wrap h140"><canvas id="deviceChart"></canvas></div>
        </div>

        <!-- Countries -->
        <div class="chart-card">
            <div class="card-title">Top Countries</div>
            <% const countries = JSON.parse(topCountries); %>
            <% if (countries.length > 0) { %>
            <% const maxC = countries[0].count; %>
            <ul class="leaderboard">
                <% countries.forEach(c => { %>
                <li class="lb-item">
                    <span class="lb-flag"><%= c.flag %></span>
                    <span class="lb-label"><%= c.label %></span>
                    <div class="lb-bar-wrap"><div class="lb-bar" style="width:<%= Math.round(c.count/maxC*100) %>%"></div></div>
                    <span class="lb-count"><%= c.count %></span>
                </li>
                <% }) %>
            </ul>
            <% } else { %>
            <div class="empty-state" style="padding:1.5rem 0;">No data yet</div>
            <% } %>
        </div>

        <!-- Browsers -->
        <div class="chart-card">
            <div class="card-title">Top Browsers</div>
            <% const browsers = JSON.parse(topBrowsers); %>
            <% if (browsers.length > 0) { %>
            <% const maxB = browsers[0].count; %>
            <ul class="leaderboard">
                <% browsers.forEach(b => { %>
                <li class="lb-item">
                    <span class="lb-label" style="width:100px;"><%= b.label %></span>
                    <div class="lb-bar-wrap"><div class="lb-bar" style="width:<%= Math.round(b.count/maxB*100) %>%;background:var(--accent2)"></div></div>
                    <span class="lb-count"><%= b.count %></span>
                </li>
                <% }) %>
            </ul>
            <% } else { %>
            <div class="empty-state" style="padding:1.5rem 0;">No data yet</div>
            <% } %>
        </div>
    </div>

    <!-- Row 3: OS + Referrers -->
    <div class="grid-2" style="margin-bottom:1.25rem;">
        <!-- OS -->
        <div class="chart-card">
            <div class="card-title">Operating Systems</div>
            <% const osList = JSON.parse(topOS); %>
            <% if (osList.length > 0) { %>
            <% const maxO = osList[0].count; %>
            <ul class="leaderboard">
                <% osList.forEach(o => { %>
                <li class="lb-item">
                    <span class="lb-label"><%= o.label %></span>
                    <div class="lb-bar-wrap"><div class="lb-bar" style="width:<%= Math.round(o.count/maxO*100) %>%;background:var(--warn)"></div></div>
                    <span class="lb-count"><%= o.count %></span>
                </li>
                <% }) %>
            </ul>
            <% } else { %>
            <div class="empty-state" style="padding:1.5rem 0;">No data yet</div>
            <% } %>
        </div>

        <!-- Referrers -->
        <div class="chart-card">
            <div class="card-title">Top Referrers</div>
            <% const referrers = JSON.parse(topReferrers); %>
            <% if (referrers.length > 0) { %>
            <% const maxR = referrers[0].count; %>
            <ul class="leaderboard">
                <% referrers.forEach(r => { %>
                <li class="lb-item">
                    <span class="lb-label" style="width:150px;"><%= r.label %></span>
                    <div class="lb-bar-wrap"><div class="lb-bar" style="width:<%= Math.round(r.count/maxR*100) %>%;background:var(--success)"></div></div>
                    <span class="lb-count"><%= r.count %></span>
                </li>
                <% }) %>
            </ul>
            <% } else { %>
            <div class="empty-state" style="padding:1.5rem 0;">No data yet</div>
            <% } %>
        </div>
    </div>

    <!-- Visit History Table -->
    <div class="section-heading">Visit History</div>
    <div class="table-wrap">
        <% if (visitHistory.length > 0) { %>
        <table>
            <thead>
                <tr>
                    <th class="idx">#</th>
                    <th>Time</th>
                    <th>Country</th>
                    <th>City</th>
                    <th>Browser</th>
                    <th>OS</th>
                    <th>Device</th>
                    <th>Referrer</th>
                </tr>
            </thead>
            <tbody>
                <% visitHistory.slice().reverse().slice(0, 50).forEach((v, i) => { %>
                <tr>
                    <td class="idx"><%= i + 1 %></td>
                    <td><%= new Date(v.timestamps).toLocaleString('en-US', { dateStyle:'medium', timeStyle:'short' }) %></td>
                    <td><%= v.country || '—' %></td>
                    <td><%= v.city    || '—' %></td>
                    <td><%= v.browser || '—' %></td>
                    <td><%= v.os      || '—' %></td>
                    <td><%= v.device  || '—' %></td>
                    <td style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= v.referrer %>"><%= v.referrer || '—' %></td>
                </tr>
                <% }) %>
            </tbody>
        </table>
        <% if (visitHistory.length > 50) { %>
        <div style="text-align:center;padding:0.75rem;font-size:0.78rem;color:var(--text-muted);">
            Showing last 50 of <%= visitHistory.length %> visits
        </div>
        <% } %>
        <% } else { %>
        <div class="empty-state">No visits yet — share the link to start tracking!</div>
        <% } %>
    </div>
</div>

<script>
const chartDefaults = {
    color: { dark: '#8888aa' },
    plugins: {
        legend: { display: false },
        tooltip: {
            backgroundColor: '#1f1f2a', borderColor: '#2a2a38', borderWidth: 1,
            titleColor: '#8888aa', bodyColor: '#e8e8f0',
        }
    }
};

// ── 7-day click bar chart ──
new Chart(document.getElementById('clickChart').getContext('2d'), {
    type: 'bar',
    data: {
        labels: <%- chartDays %>,
        datasets: [{
            label: 'Clicks',
            data: <%- chartCounts %>,
            backgroundColor: 'rgba(108,99,255,0.5)',
            borderColor: 'rgba(108,99,255,1)',
            borderWidth: 1, borderRadius: 4,
        }]
    },
    options: {
        responsive: true, maintainAspectRatio: false,
        ...chartDefaults,
        plugins: { ...chartDefaults.plugins },
        scales: {
            x: { grid: { color: '#2a2a38' }, ticks: { color: '#8888aa', font: { size: 11 } } },
            y: { grid: { color: '#2a2a38' }, ticks: { color: '#8888aa', font: { size: 11 }, stepSize: 1, precision: 0 }, beginAtZero: true }
        }
    }
});

// ── Device doughnut chart ──
const dc = <%- deviceCounts %>;
const deviceLabels  = Object.keys(dc).filter(k => dc[k] > 0);
const deviceData    = deviceLabels.map(k => dc[k]);
const deviceColors  = { Desktop: '#6c63ff', Mobile: '#22d3ee', Tablet: '#22c55e', Other: '#8888aa' };

if (deviceData.length > 0) {
    new Chart(document.getElementById('deviceChart').getContext('2d'), {
        type: 'doughnut',
        data: {
            labels: deviceLabels,
            datasets: [{
                data: deviceData,
                backgroundColor: deviceLabels.map(l => deviceColors[l] || '#8888aa'),
                borderColor: '#18181f', borderWidth: 2,
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: true, position: 'bottom',
                    labels: { color: '#8888aa', font: { size: 11 }, boxWidth: 10, padding: 10 }
                },
                tooltip: chartDefaults.plugins.tooltip,
            },
            cutout: '65%',
        }
    });
} else {
    document.getElementById('deviceChart').parentElement.innerHTML =
        '<div class="empty-state" style="padding:2rem 0;font-size:0.85rem;">No data yet</div>';
}
    document.querySelectorAll('.delete-form').forEach(form => {
        form.addEventListener('submit', (e) => {
            if (!confirm('Delete this link permanently?')) e.preventDefault();
        });
    });
</script>

</body>
</html>
