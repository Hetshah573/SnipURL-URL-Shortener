<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Protected Link — SnipURL</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Inter', sans-serif;
            background: #0f0f13;
            color: #e8e8f0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }
        .brand { font-size: 1.4rem; font-weight: 700; margin-bottom: 1.75rem; }
        .brand .dot { color: #6c63ff; }
        .card {
            width: 100%;
            max-width: 400px;
            background: #18181f;
            border: 1px solid #2a2a38;
            border-radius: 14px;
            padding: 2rem;
        }
        .lock { font-size: 2rem; margin-bottom: 0.75rem; }
        h1 { font-size: 1.2rem; font-weight: 600; margin-bottom: 0.35rem; }
        p { font-size: 0.85rem; color: #8888aa; margin-bottom: 1.5rem; }
        .error-box {
            margin-bottom: 1rem;
            padding: 0.7rem 0.9rem;
            border-radius: 8px;
            background: rgba(239, 68, 68, 0.08);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #ef4444;
            font-size: 0.84rem;
        }
        input {
            width: 100%;
            padding: 0.75rem 1rem;
            border-radius: 9px;
            border: 1px solid #2a2a38;
            background: #1f1f2a;
            color: #e8e8f0;
            font-size: 0.92rem;
            margin-bottom: 1rem;
            outline: none;
        }
        input:focus { border-color: #6c63ff; box-shadow: 0 0 0 3px rgba(108,99,255,0.25); }
        button {
            width: 100%;
            padding: 0.8rem;
            border-radius: 9px;
            border: none;
            background: #6c63ff;
            color: #fff;
            font-weight: 600;
            font-size: 0.95rem;
            cursor: pointer;
        }
        button:hover { background: #7d75ff; }
    </style>
</head>
<body>
    <div class="brand">✂ Snip<span class="dot">URL</span></div>
    <div class="card">
        <div class="lock">🔒</div>
        <h1>Password Required</h1>
        <p>This short link (<strong>/<%= shortId %></strong>) is protected. Enter the password to continue.</p>

        <% if (locals.error) { %>
        <div class="error-box">⚠ <%= error %></div>
        <% } %>

        <form method="POST" action="/url/<%= shortId %>/unlock">
            <input type="password" name="password" placeholder="Enter link password" required autofocus>
            <button type="submit">Unlock &amp; Continue →</button>
        </form>
    </div>
</body>
</html>
